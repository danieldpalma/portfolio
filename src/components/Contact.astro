---
import Subtitle from './Subtitle.astro';

const socialsURL = {
  linkedin: 'https://www.linkedin.com/in/danieldpalma',
  instagram: 'https://www.instagram.com/danieldpalma/',
};
---

<section class="mt-8 md:mt-10">
  <Subtitle value="Contato" />
  <p class="mt-2 text-c2">
    💬 Pode entrar em contato comigo pelo {' '}
    <a
      href={socialsURL.linkedin}
      target="_blank"
      rel="noreferrer noopener nofollow"
    >
      <span
        class="font-mono font-semibold text-blue-700 underline decoration-dashed"
        >LinkedIn</span
      >
    </a>
    {' '} ou pelo {' '}
    <a
      href={socialsURL.instagram}
      target="_blank"
      rel="noreferrer noopener nofollow"
    >
      <span
        class="font-mono font-semibold text-pink-500 underline decoration-dashed"
        >Instagram</span
      >
    </a>
  </p>
</section>
