---
import Subtitle from './Subtitle.astro';

const socialsURL = {
  linkedin: 'https://www.linkedin.com/in/danieldpalma',
  instagram: 'https://www.instagram.com/danieldpalma/',
};
---

<section class="contact mt-10">
  <Subtitle value="Contato" />
  <span class="text-c2"
    >💬 Pode entrar em contato comigo pelo&nbsp
    <a
      href={socialsURL.linkedin}
      target="_blank"
      rel="noreferrer noopener nofollow"
    >
      <span
        class="text-blue-700 font-mono font-semibold underline decoration-dashed"
      >
        LinkedIn</span
      ></a
    > ou pelo&nbsp
    <a
      href={socialsURL.instagram}
      target="_blank"
      rel="noreferrer noopener nofollow"
    >
      <span
        class="text-pink-500 font-mono font-semibold underline decoration-dashed"
        >Instagram</span
      >
    </a>
  </span>
</section>

<style>
  .contact {
    color: #8f5c38;
  }
</style>
