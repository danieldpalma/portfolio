---
import { Image } from 'astro:assets';

const githubProfilePicrureURL = 'https://github.com/danieldpalma.png';
---

<section
  class="grid grid-cols-1 justify-items-center gap-6 text-center md:grid-cols-2 md:justify-items-start md:gap-0.5 md:text-left"
>
  <Image
    src={githubProfilePicrureURL}
    alt={'Github profile'}
    width={280}
    height={280}
    loading="eager"
    class="rounded-2xl"
  />

  <div class="content-center font-serif">
    <h1 class="text-3xl font-bold text-c4 md:text-[40px]">
      Daniel Dario Palma
    </h1>
    <h2 class="text-xl font-semibold text-c2 md:text-2xl">
      Desenvolvedor Backend .NET <br /> Suporte Técnico
    </h2>
    <p class="text-lg text-c2 md:text-[20px]">📌 Campinas - SP</p>
  </div>
</section>
