---
import Subtitle from './Subtitle.astro';

const skillsGroups = [
  { label: '🤖 Linguagens:', items: ['C#', 'Javascript', 'Typescript'] },
  {
    label: '⚙️ Backend:',
    items: ['.NET', 'WebApi', 'NodeJs', 'Entity Framework', 'APIs REST'],
  },
  { label: '🖥️ Frontend:', items: ['React', 'Angular'] },
  { label: '🗄️ Banco de Dados:', items: ['SQL Server', 'MySql', 'SQLite'] },
  { label: '🛠️ Ferramentas:', items: ['Git', 'GitHub', 'Docker'] },
  { label: '👀 Curiosidade:', items: ['Avalonia UI', '.NET MAUI'] },
];
---

<section class="mt-8 md:mt-10">
  <Subtitle value="Habilidades Técnicas" />
  {
    skillsGroups.map((group) => (
      <div class="mt-4 flex flex-col gap-2 text-c2 md:flex-row md:items-center md:gap-3">
        <h3 class="text-lg font-semibold md:text-[20px]">{group.label}</h3>
        <ul class="flex flex-wrap gap-2 justify-center">
          {group.items.map((item) => (
            <li class="rounded-2xl bg-amber-800 px-3 py-0.75 text-sm text-gray-50 md:text-base">
              <em>{item}</em>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>
